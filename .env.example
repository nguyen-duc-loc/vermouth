# Configuration arrives from the environment only (STK-8). Copy this file to
# .env, which is ignored by git, and fill in the signing keys with
# `task dev:keys`. These same variable names become a ConfigMap and a Secret in
# the local platform, so the code does not change between host and cluster.

# ---------------------------------------------------------------- logging
LOG_LEVEL=info

# ---------------------------------------------------------------- the broker
# Redpanda's external listener, as published by test/compose.test.yaml.
BROKER_SEEDS=localhost:19092
# Fixed at topic creation and never changed afterwards (STK-17).
TOPIC_PARTITIONS=3

# ------------------------------------------------------- outbox and consumers
# How often the relay wakes to drain the outbox (STK-18). An event reaches its
# consumer roughly this long after the write commits.
RELAY_INTERVAL=750ms
# Bounded retry before a message is parked in <topic>.dlq (STK-13).
CONSUMER_RETRY_MAX=5
CONSUMER_RETRY_BASE_DELAY=200ms

# ---------------------------------------------------------------- tokens
# Run `task dev:keys` and paste the three lines it prints here. identity holds
# the private half and alone mints tokens; everybody else holds only the public
# half and verifies locally, with no network call (INV-14).
IDENTITY_TOKEN_KID=
IDENTITY_TOKEN_PRIVATE_KEY=
TOKEN_PUBLIC_KEYS=
# How long an access token lives. The browser keeps it in memory only and asks
# /api/auth/refresh for the next one (spec 0004).
IDENTITY_TOKEN_TTL=15m

# ---------------------------------------------------------------- addresses
GATEWAY_HTTP_ADDR=:8080
IDENTITY_HTTP_ADDR=:8081
TEACHING_HTTP_ADDR=:8082
BILLING_HTTP_ADDR=:8083
NOTIFICATIONS_HTTP_ADDR=:8084

# Where the gateway finds each service. It is the only caller allowed (INV-1).
GATEWAY_IDENTITY_URL=http://localhost:8081
GATEWAY_TEACHING_URL=http://localhost:8082
GATEWAY_BILLING_URL=http://localhost:8083
GATEWAY_NOTIFICATIONS_URL=http://localhost:8084
GATEWAY_UPSTREAM_TIMEOUT=5s

# ---------------------------------------------------------------- databases
# One database, one role, one migration set per service (STK-5). No service ever
# holds another service's URL.
POSTGRES_PASSWORD=vermouth
IDENTITY_DATABASE_URL=postgres://vermouth_identity:vermouth@localhost:5433/vermouth_identity?sslmode=disable
TEACHING_DATABASE_URL=postgres://vermouth_teaching:vermouth@localhost:5434/vermouth_teaching?sslmode=disable
BILLING_DATABASE_URL=postgres://vermouth_billing:vermouth@localhost:5435/vermouth_billing?sslmode=disable
NOTIFICATIONS_DATABASE_URL=postgres://vermouth_notifications:vermouth@localhost:5436/vermouth_notifications?sslmode=disable

# ---------------------------------------------------------------- the web app
# Left unset on purpose, so the browser calls its own origin and the Vite dev server
# proxies /api, /health and /ready to the gateway (web/vite.config.ts). Same origin means
# no preflight, which is why the gateway carries no CORS headers, and it matches feature 5,
# where the built static files sit behind the same edge as the gateway. Set this only for an
# origin the gateway does not share, and add CORS at the gateway in the same change.
# VITE_API_BASE_URL=http://localhost:8080

# ------------------------------------------------------- google sign in (0004)
# The Kubernetes development platform keeps this false unless you provide the
# three Google values below. Set it true for the host path when you want Google.
VERMOUTH_GOOGLE_AUTH_ENABLED=false
# identity runs the whole Google exchange itself as a confidential client, so the
# client secret lives here and nowhere else: not in the gateway, not in the
# browser. Create the OAuth client at https://console.cloud.google.com, type
# "Web application", and paste its two values here.
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=
# The callback address, which must match the Google console entry character for
# character. A mismatch shows up as a Google error page and in no log here.
IDENTITY_GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
# Where the callback sends the browser back to. Every redirect is built from
# this, never from anything the caller sent, which is what closes the open
# redirect. The Vite dev server in development, the one edge in feature 5.
IDENTITY_APP_URL=http://localhost:5173
# Comma separated emails allowed to create a tutor. Empty means nobody new, which
# is the safe reading rather than a silent default: an existing tutor still signs
# in regardless, so removing an address never locks anybody out. An entry with no
# @ in it stops startup, because a typo in a gate should be loud.
IDENTITY_SIGNUP_ALLOWLIST=
# How long a session survives without a sign in, slid forward on every rotation.
IDENTITY_REFRESH_TTL=720h
# How long after a rotation the old refresh token still rotates instead of ending
# the family. This is what keeps two tabs booting together from looking like
# theft. Shorter is stricter; zero turns the grace off entirely.
IDENTITY_REFRESH_GRACE=10s
# How often expired sign in attempts and finished session families are swept. Its
# own value, not the relay's 750ms, because these rows live ten minutes and
# thirty days.
IDENTITY_SWEEP_INTERVAL=10m
# Only set this false for an origin a browser does not treat as trustworthy.
# localhost already counts as one, so true works in development.
IDENTITY_COOKIE_SECURE=true

# ---------------------------------------------------- local object storage
# Bootstrap fills missing control and billing key values without replacing an
# existing value. Only billing receives the S3 pair in the cluster.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
BILLING_S3_ENDPOINT=http://garage:3900
BILLING_S3_REGION=garage
BILLING_S3_BUCKET=vermouth-invoices
BILLING_S3_ACCESS_KEY_ID=
BILLING_S3_SECRET_ACCESS_KEY=
