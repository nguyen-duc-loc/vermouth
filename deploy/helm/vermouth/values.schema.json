{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "jobs", "imagePullSecrets", "images", "secrets", "config", "ingress"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gitSHA", "githubRunID", "githubRunAttempt", "identity", "imagesJSONSHA256", "deploymentBaseSHA256", "migrationCompatEvidenceSHA256", "rateLimitEvidenceSHA256", "bundleManifestSHA256"],
      "properties": {
        "gitSHA": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
        "githubRunID": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" },
        "githubRunAttempt": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" },
        "identity": { "type": "string", "pattern": "^$|^[0-9a-f]{40}/[1-9][0-9]*-[1-9][0-9]*$" },
        "imagesJSONSHA256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "deploymentBaseSHA256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "migrationCompatEvidenceSHA256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "rateLimitEvidenceSHA256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "bundleManifestSHA256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "bootstrapStorage"],
      "properties": {
        "enabled": { "type": "boolean" },
        "bootstrapStorage": { "type": "boolean" }
      }
    },
    "application": { "$ref": "#/definitions/gate" },
    "jobs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runID"],
      "properties": {
        "runID": { "type": "string", "pattern": "^$|^[0-9a-f]{12}$|^[1-9][0-9]*-[1-9][0-9]*$" },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "services"],
          "properties": {
            "enabled": { "type": "boolean" },
            "services": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["identity", "teaching", "billing", "notifications"] }
            }
          }
        },
        "garageInit": { "$ref": "#/definitions/gate" },
        "devtoken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "args"],
          "properties": {
            "enabled": { "type": "boolean" },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/secretName" }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["garageInit", "gateway", "identity", "teaching", "billing", "notifications", "web", "devtoken", "migrations"],
      "properties": {
        "storageGuard": { "$ref": "#/definitions/image" },
        "postgres": { "$ref": "#/definitions/image" },
        "redpanda": { "$ref": "#/definitions/image" },
        "garage": { "$ref": "#/definitions/image" },
        "garageInit": { "$ref": "#/definitions/image" },
        "gateway": { "$ref": "#/definitions/image" },
        "identity": { "$ref": "#/definitions/image" },
        "teaching": { "$ref": "#/definitions/image" },
        "billing": { "$ref": "#/definitions/image" },
        "notifications": { "$ref": "#/definitions/image" },
        "web": { "$ref": "#/definitions/image" },
        "devtoken": { "$ref": "#/definitions/image" },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "teaching", "billing", "notifications"],
          "properties": {
            "identity": { "$ref": "#/definitions/image" },
            "teaching": { "$ref": "#/definitions/image" },
            "billing": { "$ref": "#/definitions/image" },
            "notifications": { "$ref": "#/definitions/image" }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateway", "identity", "teaching", "billing", "notifications"],
      "properties": {
        "gateway": { "$ref": "#/definitions/secretName" },
        "identity": { "$ref": "#/definitions/secretName" },
        "teaching": { "$ref": "#/definitions/secretName" },
        "billing": { "$ref": "#/definitions/secretName" },
        "notifications": { "$ref": "#/definitions/secretName" },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "teaching", "billing", "notifications"],
          "properties": {
            "identity": { "$ref": "#/definitions/secretName" },
            "teaching": { "$ref": "#/definitions/secretName" },
            "billing": { "$ref": "#/definitions/secretName" },
            "notifications": { "$ref": "#/definitions/secretName" }
          }
        },
        "garage": { "$ref": "#/definitions/secretName" },
        "billingS3": { "$ref": "#/definitions/secretName" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "apiBasePath", "gatewayTrustedProxyCIDRs", "gatewayAuthRateStartIP", "gatewayAuthRateStartGlobal", "gatewayAuthRateCallbackIP", "gatewayAuthRateCallbackGlobal", "gatewayAuthRateRefreshIP", "gatewayAuthRateRefreshToken", "gatewayAuthRateRefreshGlobal", "googleAuthEnabled"],
      "properties": {
        "environment": { "enum": ["local", "production"] },
        "apiBasePath": { "const": "/api" },
        "logLevel": { "type": "string" },
        "brokerSeeds": { "type": "string" },
        "topicPartitions": { "type": "string" },
        "relayInterval": { "type": "string" },
        "consumerRetryMax": { "type": "string" },
        "consumerRetryBaseDelay": { "type": "string" },
        "gatewayTrustedProxyCIDRs": { "type": "string", "minLength": 1 },
        "gatewayAuthRateStartIP": { "$ref": "#/definitions/authRate" },
        "gatewayAuthRateStartGlobal": { "$ref": "#/definitions/authRate" },
        "gatewayAuthRateCallbackIP": { "$ref": "#/definitions/authRate" },
        "gatewayAuthRateCallbackGlobal": { "$ref": "#/definitions/authRate" },
        "gatewayAuthRateRefreshIP": { "$ref": "#/definitions/authRate" },
        "gatewayAuthRateRefreshToken": { "$ref": "#/definitions/authRate" },
        "gatewayAuthRateRefreshGlobal": { "$ref": "#/definitions/authRate" },
        "googleAuthEnabled": { "type": "boolean" },
        "identityAppURL": { "type": "string" },
        "identityGoogleRedirectURL": { "type": "string" },
        "identitySignupAllowlist": { "type": "string" },
        "identityRefreshTTL": { "type": "string" },
        "identityTokenTTL": { "type": "string" },
        "identityRefreshGrace": { "type": "string" },
        "identitySweepInterval": { "type": "string" },
        "identityCookieSecure": { "type": "string" },
        "billingS3Endpoint": { "type": "string" },
        "billingS3Region": { "type": "string" },
        "billingS3Bucket": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hostname", "entryPoint", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$"
        },
        "entryPoint": { "enum": ["web", "websecure"] },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "certResolver"],
          "properties": {
            "enabled": { "type": "boolean" },
            "certResolver": { "type": "string", "pattern": "^$|^[a-z][a-z0-9-]*$" }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["className", "nodeName", "rootPath", "markerSHA256", "guard", "postgres", "redpanda", "garageMetadata", "garageData", "traefikACME"],
      "properties": {
        "className": { "const": "vermouth-local" },
        "nodeName": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$" },
        "rootPath": { "type": "string", "pattern": "^/[^\\r\\n]+$" },
        "markerSHA256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "guard": { "$ref": "#/definitions/gate" },
        "postgres": { "$ref": "#/definitions/storageSize" },
        "redpanda": { "$ref": "#/definitions/storageSize" },
        "garageMetadata": { "$ref": "#/definitions/storageSize" },
        "garageData": { "$ref": "#/definitions/storageSize" },
        "traefikACME": { "$ref": "#/definitions/storageSize" }
      }
    }
  },
  "definitions": {
    "authRate": {
      "type": "string",
      "pattern": "^[1-9][0-9]*/1m,[1-9][0-9]*/1h$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "type": "boolean" } }
    },
    "image": {
      "type": "string",
      "pattern": "^$|^\\S+@sha256:[0-9a-f]{64}$"
    },
    "secretName": {
      "type": "string",
      "pattern": "^$|^[a-z][a-z0-9-]*$"
    },
    "storageSize": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(Mi|Gi)$"
    }
  }
}
