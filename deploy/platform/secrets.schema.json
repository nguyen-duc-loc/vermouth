{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "foundation", "runtime"],
  "properties": {
    "schema_version": { "const": 1 },
    "foundation": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/secretRecord" }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/secretRecord" }
    }
  },
  "definitions": {
    "secretRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_hash", "keys"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
        }
      }
    }
  }
}
