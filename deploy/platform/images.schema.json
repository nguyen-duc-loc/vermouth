{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_revision", "dirty", "built_at", "images"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "dirty": { "type": "boolean" },
    "built_at": { "type": "string", "format": "date-time" },
    "images": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/imageRecord" },
      "minProperties": 1
    }
  },
  "definitions": {
    "imageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload",
        "repository_path",
        "host_ref",
        "cluster_ref",
        "tag",
        "input_hash",
        "manifest_digest",
        "platforms",
        "dirty"
      ],
      "properties": {
        "workload": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "repository_path": { "type": "string", "pattern": "^vermouth/[a-z][a-z0-9-]*$" },
        "host_ref": {
          "type": "string",
          "pattern": "^127\\.0\\.0\\.1:5111/vermouth/[a-z][a-z0-9-]*:(dev|multi)-[0-9a-f]{12}$"
        },
        "cluster_ref": {
          "type": "string",
          "pattern": "^vermouth-registry:5000/vermouth/[a-z][a-z0-9-]*@sha256:[0-9a-f]{64}$"
        },
        "tag": { "type": "string", "pattern": "^(dev|multi)-[0-9a-f]{12}$" },
        "input_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["linux/arm64", "linux/amd64"] }
        },
        "dirty": { "type": "boolean" }
      }
    }
  }
}
