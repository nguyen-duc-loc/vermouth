{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "hostname", "storage_identity", "current_release", "previous_release", "goose_versions", "roots", "regular_file_bytes", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "created_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "hostname": { "type": "string", "minLength": 1 },
    "storage_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vm_name", "node_name", "storage_mode", "storage_root", "storage_uuid", "selected_at", "marker_sha256"],
      "properties": {
        "vm_name": { "const": "nguyenducloc-vm2" },
        "node_name": { "const": "nguyenducloc-vm2" },
        "storage_mode": { "enum": ["dedicated", "os-fallback"] },
        "storage_root": { "enum": ["/var/lib/vermouth", "/var/lib/rancher/k3s/storage/vermouth"] },
        "storage_uuid": { "type": ["string", "null"] },
        "selected_at": { "type": "string", "format": "date-time" },
        "marker_sha256": { "$ref": "#/definitions/hash" }
      }
    },
    "current_release": { "$ref": "#/definitions/release" },
    "previous_release": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/release" }] },
    "goose_versions": { "$ref": "#/definitions/gooseVersions" },
    "roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "regular_file_bytes": { "type": "integer", "minimum": 0 },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["size", "sha256"],
        "properties": {
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/definitions/hash" }
        }
      }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "helm_revision", "images_json_sha256", "deployment_base_sha256", "migration_compat_evidence_sha256", "rate_limit_evidence_sha256", "bundle_manifest_sha256", "image_digests"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[0-9a-f]{40}/[1-9][0-9]*-[1-9][0-9]*$" },
        "helm_revision": { "type": "integer", "minimum": 1 },
        "images_json_sha256": { "$ref": "#/definitions/hash" },
        "deployment_base_sha256": { "$ref": "#/definitions/hash" },
        "migration_compat_evidence_sha256": { "$ref": "#/definitions/hash" },
        "rate_limit_evidence_sha256": { "$ref": "#/definitions/hash" },
        "bundle_manifest_sha256": { "$ref": "#/definitions/hash" },
        "image_digests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["billing", "billing-migration", "garage-init", "gateway", "identity", "identity-migration", "notifications", "notifications-migration", "teaching", "teaching-migration", "web"],
          "properties": {
            "billing": { "$ref": "#/definitions/digest" },
            "billing-migration": { "$ref": "#/definitions/digest" },
            "garage-init": { "$ref": "#/definitions/digest" },
            "gateway": { "$ref": "#/definitions/digest" },
            "identity": { "$ref": "#/definitions/digest" },
            "identity-migration": { "$ref": "#/definitions/digest" },
            "notifications": { "$ref": "#/definitions/digest" },
            "notifications-migration": { "$ref": "#/definitions/digest" },
            "teaching": { "$ref": "#/definitions/digest" },
            "teaching-migration": { "$ref": "#/definitions/digest" },
            "web": { "$ref": "#/definitions/digest" }
          }
        }
      }
    },
    "gooseVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "teaching", "billing", "notifications"],
      "properties": {
        "identity": { "type": "integer", "minimum": 0 },
        "teaching": { "type": "integer", "minimum": 0 },
        "billing": { "type": "integer", "minimum": 0 },
        "notifications": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
