{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "git_sha", "test_target", "threshold_configuration_sha256", "pass", "timestamp"],
  "properties": {
    "schema_version": { "const": 1 },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "test_target": { "const": "task test:auth-rate-limit" },
    "threshold_configuration_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "pass": { "const": true },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
